    },
    {
      "type": "clause",
      "clause_number": "clause_2",
      "clause_title": "",
      "text": "২। এই প্রজ্ঞাপন ১ জুলাই, ২০২২ খ্রিষ্টাব্দ তারিখে কার্যকর হইবে।",
      "subclause_hierarchy": "",
      "page_start": 2,
      "page_end": 2,
      "text_id": "20220628_218-_2022_126_২৮ জুন, ২০২২_clause_2",
