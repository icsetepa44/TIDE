    {
      "type": "clause",
      "clause_number": "clause_2",
      "clause_title": "",
      "text": "২। ০৫ জুন, ২০১৪ খ্রিষ্টাব্দ তারিখের প্রজ্ঞাপন এস,আর,ও, নং- ১২২-আইন/২০১৪/২৪৮৬/ কাস্টমস এতদ্বারা রহিত করা হইল।",
      "subclause_hierarchy": "",
      "page_start": 43,
      "page_end": 43,
      "text_id": "20240606_175-AIN_2024_27_Customs_২৯ মে, ২০২৪_clause_2",
      "table_ids": []
