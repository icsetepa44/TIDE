    {
      "type": "clause",
      "clause_number": "clause_2",
      "clause_title": "",
      "text": "২। এই প্রজ্ঞাপন ২ জুন, ২০২৫ খ্রিস্টাব্দ তারিখে কার্যকর হইবে।",
      "subclause_hierarchy": "",
      "page_start": 6,
      "page_end": 6,
      "text_id": "20250602_211-AIN_2025_33_Customs_২৯ মে, ২০২৫_clause_2",
      "table_ids": []
    },
    {
      "type": "metadata",
      "metadata_category": "document",
      "metadata_title": "",
      "text": "রাষ্ট্রপতির আদেশক্রমে,\n\nস্বাক্ষরিত/-\nমোঃ আবদুর রহমান খান এফসিএমএ\nসচিব।",
      "page_start": 6,
      "page_end": 6,
      "text_id": "metadata_8",
      "table_ids": []
    }
