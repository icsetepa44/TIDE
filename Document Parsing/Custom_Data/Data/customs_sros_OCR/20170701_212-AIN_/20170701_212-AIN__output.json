  "parsed_text": [
    {
      "type": "metadata",
      "metadata_category": "document",
      "metadata_title": "গণপ্রজাতন্ত্রী বাংলাদেশ সরকার, অর্থ মন্ত্রণালয়, অভ্যন্তরীণ সম্পদ বিভাগ",
      "text": "গণপ্রজাতন্ত্রী বাংলাদেশ সরকার\nঅর্থ মন্ত্রণালয়\nঅভ্যন্তরীণ সম্পদ বিভাগ\n\n(কাস্টমস ও মূল্য সংযোজন কর)\n\nপ্রজ্ঞাপন\n\nতারিখ, ১৭ আষাঢ়, ১৪২৪ বঙ্গাব্দ/০১ জুলাই, ২০১৭ খ্রিস্টাব্দ",
      "page_start": 1,
      "page_end": 1,
      "text_id": "metadata_1",
      "table_ids": []
    },
    {
      "type": "clause",
      "clause_number": "clause_1",
      "clause_title": "এস.আর.ও. নং- ২১২-আইন/২০১৭/৫০/কাস্টমস",
      "text": "এস.আর.ও. নং- ২১২-আইন/২০১৭/৫০/কাস্টমস |- Customs Act, 1969 (Act No. IV of 1969) এর section 19 এর sub-section (1) এবং মূল্য সংযোজন কর আইন, ১৯৯১ (১৯৯১ সনের ২২ নং আইন) এর ধারা ১৪ এর উপ-ধারা (১) এ প্রদত্ত ক্ষমতাবলে সরকার, জনস্বার্থে, জাতীয় রাজস্ব বোর্ডের সহিত পরামর্শক্রমে, এই বিভাগের ১৮ জ্যৈষ্ঠ, ১৪২৪ বঙ্গাব্দ মোতাবেক ১ জুন, ২০১৭ খ্রিস্টাব্দ তারিখের প্রজ্ঞাপন এস.আর.ও. নং ১২৮-আইন/২০১৭/১৪/কাস্টমস এর নিম্নরূপ সংশোধন করিল, যথা:-\n\nউপরিউক্ত প্রজ্ঞাপনের TABLE এর পরিবর্তে নিম্নবর্ণিত TABLE প্রতিস্থাপিত হইবে, যথা:-\n\n“TABLE\n\n[table_1]”",
      "subclause_hierarchy": "",
      "page_start": 1,
      "page_end": 6,
