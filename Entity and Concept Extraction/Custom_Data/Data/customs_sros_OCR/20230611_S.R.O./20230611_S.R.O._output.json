  "parsed_text": [
    {
      "type": "metadata",
      "metadata_category": "document",
      "metadata_title": "বাংলাদেশ গেজেট প্রজ্ঞাপন",
      "text": "রেজিস্টার্ড নং ডি এ-১\nবাংলাদেশ গেজেট\nঅতিরিক্ত সংখ্যা\nকর্তৃপক্ষ কর্তৃক প্রকাশিত\nমঙ্গলবার, জুন ৬, ২০২৩\n\nগণপ্রজাতন্ত্রী বাংলাদেশ সরকার\nঅভ্যন্তরীণ সম্পদ বিভাগ\nজাতীয় রাজস্ব বোর্ড\n(কাস্টমস)\nপ্রজ্ঞাপন\nতারিখ: ১৮ জ্যৈষ্ঠ, ১৪৩০ বঙ্গাব্দ/০১ জুন, ২০২৩ খ্রিস্টাব্দ",
      "page_start": 1,
      "page_end": 1,
      "text_id": "metadata_1",
      "table_ids": []
    },
    {
      "type": "clause",
      "clause_number": "clause_1",
      "clause_title": "এস.আর.ও. নং-১৭৭-আইন/২০২৩/৯৮০/কাস্টমস",
      "text": "এস.আর.ও. নং-১৭৭-আইন/২০২৩/৯৮০/কাস্টমস—জাতীয় রাজস্ব বোর্ড, Customs Act, 1969 (Act No. IV of 1969) এর section 11 এ প্রদত্ত ক্ষমতাবলে, নিম্নবর্ণিত তফসিলে উল্লিখিত এলাকাসমূহকে শেওলা স্থল কাস্টমস স্টেশনের ওয়্যারহাউজিং স্টেশন (Warehousing Station) হিসাবে ঘোষণা করিল, যথা:—\n\nতফসিল\n\n(ক) স্থল কাস্টমস স্টেশনের নাম: শেওলা স্থল কাস্টমস স্টেশন, বিয়ানীবাজার, সিলেট;\n\n(খ) স্থল কাস্টমস স্টেশনের সীমা নিম্নরূপ, যথা :—\n\n১। জমির বিবরণ:\n[table_1]\n\n২। চৌহদ্দি:\n(অ) উত্তরে : একাংশে বলেশ্বর খাল ও অন্যাংশে কৃষি জমি;\n(আ) দক্ষিণে : সিলেট-সুতারকান্দি-করিমগঞ্জ মহাসড়ক;\n(ই) পূর্বে : ভারতীয় সীমানা;\n(ঈ) পশ্চিমে : কৃষি জমি ও অকৃষি জমি।",
      "subclause_hierarchy": "[ক খ [১ ২ [অ আ ই ঈ]]]",
      "page_start": 1,
      "page_end": 7,
      "text_id": "20230611_S.R.O._৬ জুন, ২০২৩_clause_1",
