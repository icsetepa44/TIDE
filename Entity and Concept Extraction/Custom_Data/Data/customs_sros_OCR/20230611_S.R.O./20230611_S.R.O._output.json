    {
      "type": "metadata",
      "metadata_category": "document",
      "metadata_title": "স্বাক্ষরকারী কর্তৃপক্ষ",
      "text": "জাতীয় রাজস্ব বোর্ডের আদেশক্রমে,\nআবু হেনা মোঃ রহমাতুল মুনিম\nচেয়ারম্যান।",
      "page_start": 7,
      "page_end": 7,
      "text_id": "metadata_8",
      "table_ids": []
    },
    {
      "type": "metadata",
      "metadata_category": "page",
      "metadata_title": "পৃষ্ঠা ৭ হেডার ও ফুটার",
      "text": "বাংলাদেশ গেজেট, অতিরিক্ত, জুন ৬, ২০২৩ ৬৭৮১\n\nমোস্তাফিজুর রহমান, উপপরিচালক (ভারপ্রাপ্ত), বাংলাদেশ সরকারী মুদ্রণালয়, তেজগাঁও, ঢাকা কর্তৃক মুদ্রিত।\nব্রেনজন চাম্বুগং, উপপরিচালক (উপসচিব) (অতিরিক্ত দায়িত্ব), বাংলাদেশ ফরম ও প্রকাশনা অফিস, তেজগাঁও, ঢাকা কর্তৃক প্রকাশিত। website: www.bgpress.gov.bd",
      "page_start": 7,
      "page_end": 7,
      "text_id": "metadata_9",
      "table_ids": []
    }
