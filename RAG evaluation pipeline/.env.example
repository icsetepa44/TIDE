# ─────────────────────────────────────────────────────────────────────────────
# API keys for the RAG evaluation
# ─────────────────────────────────────────────────────────────────────────────
# SETUP: copy this file to `.env` (same folder) and fill in your real key(s).
#        `.env` is .gitignored — it is never committed.
#
#   cp .env.example .env      # then edit .env
#
# MULTIPLE KEYS: comma-separate them. Extra keys rotate automatically when one
# hits a rate-limit / quota error.
# ─────────────────────────────────────────────────────────────────────────────

# Gemini — corpus + query embedding, and the judge council's Gemini seat
# (gemini-3.5-flash).  Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2

# OpenRouter — the models under test, and the two OpenRouter judge seats
# (anthropic/claude-opus-4.6, openai/gpt-5.1).  Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEYS=your_openrouter_key

# ── Accepted alternatives (instead of the comma-separated *_KEYS vars above) ──
# Single key:
#   GEMINI_API_KEY=your_gemini_key
#   OPENROUTER_API_KEY=your_openrouter_key
# Numbered (one per line):
#   GEMINI_API_KEY_1=...
#   GEMINI_API_KEY_2=...
#   OPENROUTER_API_KEY_1=...
